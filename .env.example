# Neon PostgreSQL runtime connection (use the pooled URL for the Next.js app).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional only for guarded Neon audit/cleanup scripts; not used by the app.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Managed Better Auth (Neon Console -> branch -> Auth -> Configuration).
NEON_AUTH_BASE_URL=https://your-project.neonauth.example
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret

# Public site origin used for account recovery links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini AI (server-side only)
GEMINI_API_KEY=your-gemini-api-key

# Generate with: openssl rand -base64 32. Keep stable so stored GitHub tokens remain decryptable.
GITHUB_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Optional legacy live integration tests. Use only an isolated Neon test project;
# never copy production URLs here. Keep actual values in a private local env.
PLAYWRIGHT_AUTH_INTEGRATION=false
PLAYWRIGHT_DATABASE_INTEGRATION=false
PLAYWRIGHT_TEST_BRANCH_ID=your-neon-branch-id
PLAYWRIGHT_TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/neondb?sslmode=require
PLAYWRIGHT_TEST_DIRECT_URL=postgresql://USER:PASSWORD@TEST_HOST/neondb?sslmode=require
PLAYWRIGHT_TEST_NEON_AUTH_BASE_URL=https://your-test-project.neonauth.example
PLAYWRIGHT_TEST_PASSWORD=replace-with-dedicated-test-account-password

# Optional test process overrides; normally set only for one run or in CI:
# PLAYWRIGHT_BASE_URL, PLAYWRIGHT_CHANNEL, PLAYWRIGHT_EXTERNAL_SERVER,
# PLAYWRIGHT_AUTH_DIAGNOSTIC, E2E_BASE_URL

# The separate guarded main-Neon audit suite writes synthetic rows and verifies
# exact cleanup. Opt in only for a planned run; set this in the one command, not here.
# PLAYWRIGHT_MAIN_NEON_AUDIT=true
