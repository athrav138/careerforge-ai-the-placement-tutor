# Supabase PostgreSQL
# Runtime connection: Supabase connection pooler URL (prefer transaction pooler for serverless).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct database connection used by Prisma migrations and administrative commands.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Auth (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# Gemini AI (server-side only)
GEMINI_API_KEY="replace-with-a-gemini-api-key"
