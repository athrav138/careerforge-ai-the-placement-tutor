# Neon PostgreSQL runtime connection (use the pooled URL for the Next.js app).
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection for Prisma migrations and administrative commands.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Managed Better Auth (Neon Console -> branch -> Auth -> Configuration).
NEON_AUTH_BASE_URL="https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Public site origin used for account recovery links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Gemini AI (server-side only)
GEMINI_API_KEY="replace-with-a-gemini-api-key"

# Optional live integration tests. Use only the isolated CareerForge-AI-integration-test
# Neon project; never copy production URLs here. Keep actual values in a private local env.
PLAYWRIGHT_AUTH_INTEGRATION="false"
PLAYWRIGHT_DATABASE_INTEGRATION="false"
PLAYWRIGHT_TEST_BRANCH_ID="br-shy-hill-b4dsm90r"
PLAYWRIGHT_TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-plain-poetry-b4cy32gr-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
PLAYWRIGHT_TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-plain-poetry-b4cy32gr.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
PLAYWRIGHT_TEST_NEON_AUTH_BASE_URL="https://ep-plain-poetry-b4cy32gr.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth"
PLAYWRIGHT_TEST_PASSWORD="replace-with-a-test-only-password"
