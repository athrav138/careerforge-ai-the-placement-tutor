{
  "name": "careerforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:seed": "node prisma/seed.mjs",
    "test": "npm run test:offline",
    "test:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-offline.ps1 -Suite offline",
    "test:ui": "playwright test --ui",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-offline.ps1 -Suite api",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-offline.ps1 -Suite e2e",
    "db:integration:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task deploy",
    "test:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task test",
    "test:integration:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task auth",
    "test:integration:auth-diagnostic": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task auth-diagnostic",
    "db:integration:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task cleanup",
    "db:integration:recover-cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task recover-cleanup",
    "db:integration:diagnose-signup": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-neon-integration.ps1 -Task diagnose-signup"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@neondatabase/auth": "^0.6.0-beta",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.8.0",
    "next": "^16.4.2",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
