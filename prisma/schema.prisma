// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  supabaseUserId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?

  @@index([email])
}

// ============================================================
// STUDENT PROFILE
// ============================================================

model StudentProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  phone             String?
  location          String?
  college           String?
  degree            String?
  branch            String?
  graduationYear    Int?
  cgpa              Float?
  careerGoal        String?
  targetDomain      String?
  preferredDomain   String?
  preferredJobType  String?
  programmingLanguages String?
  frameworks        String?
  databases         String?
  tools             String?
  certifications    String?
  projects          String?
  experience        String?
  github            String?
  linkedin          String?
  portfolio         String?
  targetCareerId    String?
  profileCompletion Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentSkills           StudentSkill[]
  careerRecommendations   CareerRecommendation[]
  skillGaps               SkillGap[]
  learningRoadmaps        LearningRoadmap[]
  resumes                 Resume[]
  aptitudeAttempts        AptitudeAttempt[]
  interviewSessions       InterviewSession[]
  projectRecommendations  ProjectRecommendation[]
  readinessScores         ReadinessScore[]
  mentorConversations     MentorConversation[]
  notifications           Notification[]
  targetCareer            CareerRole?            @relation(fields: [targetCareerId], references: [id], onDelete: SetNull)
  careerAnalyses          CareerAnalysis[]
  assessmentAttempts     AssessmentAttempt[]
  skillPerformances      SkillPerformance[]
  githubConnection       GitHubConnection?
  linkedinProfile        LinkedInProfile?
  professionalEvidence    ProfessionalEvidence[]
  jobRecommendations      JobRecommendation[]
  jobApplications         JobApplication[]
  careerActions           CareerAction[]

  @@index([userId])
  @@index([targetDomain])
  @@index([targetCareerId])
}

// ============================================================
// SKILLS
// ============================================================

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())

  studentSkills StudentSkill[]
  skillGaps     SkillGap[]
  careerRoles   CareerRole[]          @relation("CareerRoleRequiredSkills")
  projects      Project[]             @relation("ProjectRequiredSkills")
  questions     Question[]
  interviewQuestions InterviewQuestion[]
  skillPerformances SkillPerformance[]
  githubSkillEvidence GitHubSkillEvidence[]
  linkedinSkills LinkedInSkill[]
  professionalEvidence ProfessionalEvidence[]

  @@index([category])
}

model StudentSkill {
  id               String   @id @default(cuid())
  studentProfileId String
  skillId          String
  level            String   // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  yearsOfExperience Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
}

// ============================================================
// CAREER ROLES & RECOMMENDATIONS
// ============================================================

model CareerRole {
  id             String   @id @default(cuid())
  title          String
  domain         String
  description    String?
  requiredSkills String[] // Array of skill IDs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  careerRecommendations CareerRecommendation[]
  skillGaps             SkillGap[]
  learningRoadmaps      LearningRoadmap[]
  skillRelations        Skill[]               @relation("CareerRoleRequiredSkills")
  targetProfiles        StudentProfile[]
  analyses              CareerAnalysis[]
  resumes               Resume[]
  recommendedProjects   Project[]                  @relation("ProjectTargetCareer")
  interviewQuestions    InterviewQuestion[]

  @@index([domain])
}

model CareerAnalysis {
  id               String   @id @default(cuid())
  studentProfileId String
  careerRoleId     String
  matchPercentage  Int
  matchedSkills    String[]
  missingSkills    String[]
  recommendations String[]
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  careerRole     CareerRole     @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, createdAt])
  @@index([careerRoleId])
}

model CareerRecommendation {
  id               String   @id @default(cuid())
  studentProfileId String
  careerRoleId     String
  matchScore       Int      // 0-100
  explanation      String?
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  careerRole     CareerRole     @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, careerRoleId])
  @@index([studentProfileId])
  @@index([careerRoleId])
}

// ============================================================
// SKILL GAPS
// ============================================================

model SkillGap {
  id               String   @id @default(cuid())
  studentProfileId String
  careerRoleId     String
  skillId          String
  currentLevel     String
  requiredLevel    String
  gapLevel         String   // LOW, MEDIUM, HIGH, CRITICAL
  priority         String   // LOW, MEDIUM, HIGH
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  careerRole     CareerRole     @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, careerRoleId, skillId])
  @@index([studentProfileId])
  @@index([careerRoleId])
  @@index([skillId])
  @@index([priority])
}

// ============================================================
// LEARNING ROADMAP
// ============================================================

model LearningRoadmap {
  id               String   @id @default(cuid())
  studentProfileId String
  careerRoleId     String
  title            String
  description      String?
  status           String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  progress         Int      @default(0) // 0-100
  startDate        DateTime?
  targetDate       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  careerRole     CareerRole     @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)
  tasks          RoadmapTask[]

  @@index([studentProfileId])
  @@index([careerRoleId])
  @@index([status])
}

model RoadmapTask {
  id              String   @id @default(cuid())
  roadmapId       String
  title           String
  description     String?
  category        String   // SKILL, PROJECT, PRACTICE, READING
  difficulty      String   // EASY, MEDIUM, HARD
  estimatedMinutes Int?
  status          String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  source          String   @default("CAREER_GAP")  // CAREER_GAP, APTITUDE_WEAK, RESUME_GAP
  skillId         String?
  priority        String   @default("MEDIUM")      // CRITICAL, HIGH, MEDIUM, LOW
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roadmap LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([status])
  @@index([source])
  @@index([dueDate])
}

// ============================================================
// RESUME & ANALYSIS
// ============================================================

model Resume {
  id               String   @id @default(cuid())
  studentProfileId String
  fileName         String
  fileUrl          String?
  fileType         String   // PDF, DOCX
  fileSize         Int?
  extractedText    String?
  targetCareerId   String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  analysis        ResumeAnalysis?
  targetCareer    CareerRole?   @relation(fields: [targetCareerId], references: [id], onDelete: SetNull)

  @@index([studentProfileId])
  @@index([targetCareerId])
}

model ResumeAnalysis {
  id                String   @id @default(cuid())
  resumeId          String   @unique
  atsScore          Int      // 0-100
  matchedSkills     String[]
  missingSkills     String[]
  detectedSkills    String[]
  keywords          String[]
  recommendations   String[]
  educationSummary  String?
  experienceSummary String?
  projectSummary    String?
  sectionScore      Int      // 0-100
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

// ============================================================
// APTITUDE
// ============================================================

enum QuestionCategory {
  QUANTITATIVE
  LOGICAL_REASONING
  VERBAL_ABILITY
  DATA_INTERPRETATION
  TECHNICAL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model Question {
  id            String            @id @default(cuid())
  question      String
  category      QuestionCategory
  difficulty    QuestionDifficulty
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String            // A, B, C, or D
  explanation   String?
  skillId       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  skill     Skill?               @relation(fields: [skillId], references: [id], onDelete: SetNull)
  answers   AssessmentAnswer[]
  assessments AssessmentQuestion[]

  @@index([category])
  @@index([difficulty])
  @@index([skillId])
}

model Assessment {
  id              String            @id @default(cuid())
  title           String
  category        QuestionCategory
  difficulty      QuestionDifficulty
  totalQuestions  Int
  durationMinutes Int
  createdAt       DateTime          @default(now())

  attempts AssessmentAttempt[]
  questions AssessmentQuestion[]

  @@index([category])
  @@index([difficulty])
}

model AssessmentQuestion {
  assessmentId String
  questionId   String
  position     Int

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([assessmentId, questionId])
  @@unique([assessmentId, position])
  @@index([questionId])
}

model AssessmentAttempt {
  id               String          @id @default(cuid())
  assessmentId     String
  studentProfileId String
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  status           AssessmentStatus @default(IN_PROGRESS)
  score            Int?            // 0-100
  percentage       Float?          // 0-100
  correctAnswers   Int?
  incorrectAnswers Int?
  unanswered       Int?
  createdAt        DateTime        @default(now())

  assessment     Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  answers        AssessmentAnswer[]

  @@index([assessmentId])
  @@index([studentProfileId])
  @@index([status])
  @@index([createdAt])
}

model AssessmentAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedAnswer String  // A, B, C, or D
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model AptitudeAttempt {
  id               String   @id @default(cuid())
  studentProfileId String
  category         String   // QUANTITATIVE, LOGICAL_REASONING, VERBAL
  difficulty       String   // EASY, MEDIUM, HARD
  totalQuestions   Int
  correctAnswers   Int
  score            Int      // 0-100
  accuracy         Float    // 0-100
  timeTaken        Int      // in seconds
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([category])
  @@index([createdAt])
}

// ============================================================
// INTERVIEW
// ============================================================

model InterviewQuestion {
  id              String   @id @default(cuid())
  question        String
  category        String   // TECHNICAL, HR, BEHAVIORAL, PROJECT, RESUME_BASED, CAREER_SPECIFIC
  difficulty      String   // EASY, MEDIUM, HARD
  expectedPoints  String?
  explanation     String?
  isActive        Boolean  @default(true)
  
  skillId         String?
  careerRoleId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skill           Skill?      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  careerRole      CareerRole? @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)
  answers         InterviewAnswer[]

  @@index([category])
  @@index([difficulty])
  @@index([skillId])
  @@index([careerRoleId])
}

model InterviewSession {
  id               String   @id @default(cuid())
  studentProfileId String
  interviewType    String   // TECHNICAL, HR, MIXED, RESUME_BASED
  difficulty       String   // EASY, MEDIUM, HARD
  numQuestions     Int      @default(5)
  targetRole       String?
  score            Float?   
  
  // Category scores
  technicalScore   Float?
  hrScore          Float?
  resumeScore      Float?
  communicationScore Float?

  status           String   @default("STARTED") // STARTED, IN_PROGRESS, COMPLETED
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  answers        InterviewAnswer[]
  legacyEvaluations LegacyInterviewEvaluation[]

  @@index([studentProfileId])
  @@index([status])
  @@index([createdAt])
}

model InterviewAnswer {
  id                  String   @id @default(cuid())
  interviewSessionId  String
  interviewQuestionId String?
  questionText        String   // Stored in case question is deleted or generated dynamically (like resume-based)
  answerText          String?
  
  createdAt           DateTime @default(now())

  interviewSession  InterviewSession   @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  interviewQuestion InterviewQuestion? @relation(fields: [interviewQuestionId], references: [id], onDelete: SetNull)
  evaluation        InterviewEvaluation?

  @@index([interviewSessionId])
  @@index([interviewQuestionId])
}

model InterviewEvaluation {
  id                  String   @id @default(cuid())
  interviewAnswerId   String   @unique
  
  score               Float    // 0-100 overall
  relevance           Float    // 0-10
  technicalAccuracy   Float    // 0-10
  completeness        Float    // 0-10
  clarity             Float    // 0-10
  professionalism     Float    // 0-10
  
  feedback            String?
  improvements        String[] @default([])
  createdAt           DateTime @default(now())

  interviewAnswer InterviewAnswer @relation(fields: [interviewAnswerId], references: [id], onDelete: Cascade)
}

model LegacyInterviewEvaluation {
  id                String   @id
  interviewSessionId String
  question          String
  answer            String?
  evaluation        String?
  score             Int?
  createdAt         DateTime @default(now())
  improvements      String[] @default([])

  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@index([interviewSessionId])
  @@map("_InterviewEvaluationLegacy")
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id                String   @id @default(cuid())
  careerRoleId      String?
  title             String
  description       String?
  difficulty        String   // EASY, MEDIUM, HARD
  domain            String
  technologies      String[] // Array of technology names
  requiredSkills    String[] // Array of skill IDs
  estimatedDuration Int?     // in hours
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recommendations ProjectRecommendation[]
  skillRelations  Skill[]               @relation("ProjectRequiredSkills")
  careerRole      CareerRole?           @relation("ProjectTargetCareer", fields: [careerRoleId], references: [id], onDelete: SetNull)

  @@index([domain])
  @@index([difficulty])
  @@index([careerRoleId])
}

model ProjectRecommendation {
  id               String   @id @default(cuid())
  studentProfileId String
  projectId        String
  relevanceScore   Int      // 0-100
  reason           String?
  status           String   @default("RECOMMENDED") // RECOMMENDED, IN_PROGRESS, COMPLETED
  repositoryUrl    String?
  demoUrl          String?
  summary          String?
  skillsDemonstrated String[] @default([])
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, projectId])
  @@index([studentProfileId])
  @@index([projectId])
  @@index([status])
}

// ============================================================
// READINESS SCORE
// ============================================================

model ReadinessScore {
  id               String   @id @default(cuid())
  studentProfileId String
  overallScore     Int      // 0-100
  careerScore      Int      // 0-100
  skillScore       Int      // 0-100
  resumeScore      Int      // 0-100
  aptitudeScore    Int      // 0-100
  interviewScore   Int      // 0-100
  projectScore     Int      // 0-100
  roadmapProgress  Int      @default(0) // 0-100
  githubScore      Int      @default(0) // 0-100
  linkedinScore    Int      @default(0) // 0-100
  weakSkillCount   Int      @default(0)
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([createdAt])
  @@index([studentProfileId, createdAt])
}

// ============================================================
// AI MENTOR
// ============================================================

model MentorConversation {
  id               String   @id @default(cuid())
  studentProfileId String
  title            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  messages        MentorMessage[]

  @@index([studentProfileId])
  @@index([createdAt])
}

model MentorMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // USER, ASSISTANT
  content        String
  actions        Json?
  createdAt      DateTime @default(now())

  conversation MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id               String   @id @default(cuid())
  studentProfileId String
  title            String
  message          String
  type             String   // INFO, SUCCESS, WARNING, ALERT
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================================
// SKILL PERFORMANCE (PHASE 4.3)
// ============================================================

model SkillPerformance {
  id                 String   @id @default(cuid())

  studentProfileId   String
  skillId            String

  totalQuestions     Int
  attemptedQuestions Int
  correctAnswers     Int
  incorrectAnswers   Int

  accuracy           Float
  classification     String
  priority           String

  assessmentCount    Int      @default(1)

  lastAssessedAt     DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill              Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
}

// ============================================================
// GITHUB INTEGRATION (PHASE 4.9)
// ============================================================

model GitHubConnection {
  id               String   @id @default(cuid())
  studentProfileId String   @unique
  username         String
  accessToken      String   // Encrypted OAuth token
  scope            String?
  lastSyncedAt     DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  repositories     GitHubRepository[]
  skillEvidence    GitHubSkillEvidence[]

  @@index([studentProfileId])
  @@index([username])
}

model GitHubRepository {
  id               String   @id @default(cuid())
  connectionId     String
  repositoryId     String   // GitHub repository ID
  name             String
  fullName         String
  description      String?
  url              String
  primaryLanguage  String?
  languages        Json?    // { language: bytes }
  stars            Int      @default(0)
  forks            Int      @default(0)
  topics           String[] @default([])
  isPublic         Boolean  @default(true)
  hasReadme        Boolean  @default(false)
  readmeLength     Int?
  hasLicense       Boolean  @default(false)
  createdAt        DateTime
  updatedAt        DateTime
  pushedAt         DateTime?
  lastSyncedAt     DateTime @default(now())

  connection       GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([repositoryId])
  @@index([primaryLanguage])
}

model GitHubSkillEvidence {
  id               String   @id @default(cuid())
  connectionId     String
  skillId          String
  repositoryIds    String[] // Array of repository IDs demonstrating this skill
  confidence       String   // HIGH, MEDIUM, LOW
  evidenceCount    Int      @default(0)
  lastAnalyzedAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connection       GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([connectionId, skillId])
  @@index([connectionId])
  @@index([skillId])
  @@index([confidence])
}

// ============================================================
// LINKEDIN INTEGRATION (PHASE 4.9)
// ============================================================

model LinkedInProfile {
  id               String   @id @default(cuid())
  studentProfileId String   @unique
  profileUrl       String?
  name             String?
  headline         String?
  about            String?
  location         String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skills           LinkedInSkill[]
  experience       LinkedInExperience[]
  education        LinkedInEducation[]

  @@index([studentProfileId])
}

model LinkedInSkill {
  id               String   @id @default(cuid())
  profileId        String
  skillId          String
  proficiency      String?  // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  endorsements     Int      @default(0)
  createdAt        DateTime @default(now())

  profile          LinkedInProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill            Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
}

model LinkedInExperience {
  id               String   @id @default(cuid())
  profileId        String
  company          String
  title            String
  description      String?
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean  @default(false)
  createdAt        DateTime @default(now())

  profile          LinkedInProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([company])
}

model LinkedInEducation {
  id               String   @id @default(cuid())
  profileId        String
  institution      String
  degree           String?
  field            String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime @default(now())

  profile          LinkedInProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([institution])
}

// ============================================================
// PROFESSIONAL EVIDENCE (PHASE 4.9)
// ============================================================

model ProfessionalEvidence {
  id               String   @id @default(cuid())
  studentProfileId String
  skillId          String
  source           String   // RESUME, GITHUB, LINKEDIN, PROJECT, APTITUDE, INTERVIEW
  sourceReference  String?  // Reference ID (e.g., repositoryId, resumeId)
  evidenceType     String   // DIRECT, INDIRECT, INFERRED
  confidence       String   // HIGH, MEDIUM, LOW
  metadata         Json?    // Additional evidence details
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId, source, sourceReference])
  @@index([studentProfileId])
  @@index([skillId])
  @@index([source])
  @@index([confidence])
}

// ============================================================
// JOB MATCHING & APPLICATIONS (PHASE 4.11)
// ============================================================

model JobOpportunity {
  id               String   @id @default(cuid())
  title            String
  company          String
  location         String?
  workMode         String?
  description      String?
  requiredSkills   String[] @default([])
  preferredSkills  String[] @default([])
  experienceLevel  String?
  salaryRange      String?
  deadline         DateTime?
  applicationUrl   String
  source           String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recommendations JobRecommendation[]
  applications    JobApplication[]

  @@index([company])
  @@index([isActive])
  @@index([deadline])
}

model JobRecommendation {
  id                String   @id @default(cuid())
  studentProfileId  String
  jobId             String
  matchScore        Int
  careerAlignment   Int
  skillCoverage     Int
  evidenceScore     Int
  resumeAlignment   Int
  projectRelevance  Int
  aptitudeReadiness Int
  interviewReadiness Int
  missingSkills     String[] @default([])
  explanation       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  job            JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, jobId])
  @@index([studentProfileId, matchScore])
  @@index([jobId])
}

model JobApplication {
  id              String   @id @default(cuid())
  studentProfileId String
  jobId           String
  status          String   @default("SAVED")
  appliedAt       DateTime?
  notes           String?
  interviewDate   DateTime?
  interviewNotes  String?
  followUpDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  job            JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, jobId])
  @@index([studentProfileId, status])
  @@index([jobId])
}

// ============================================================
// CAREER ACTION CENTER (PHASE 4.12)
// ============================================================

model CareerAction {
  id               String   @id @default(cuid())
  studentProfileId String
  title            String
  description      String
  category         String
  priority         String
  reason           String
  source           String
  sourceId         String?
  actionUrl        String?
  estimatedMinutes Int?
  completed        Boolean  @default(false)
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, source])
  @@index([studentProfileId])
  @@index([studentProfileId, completed])
}
